# Credentials — never commit, and never bundle into an installer.
# Each user supplies their own bot token through the UI.
.env
config.json

# Generated media
snapshots/
videos/
DISABLED

# Go build output
/motion-detector
/motion-detector.exe
/dist/

# Build output only — packaging metadata under build/ must stay tracked.
# git will not descend into an excluded directory, so the parent is /build/*
# rather than /build/, otherwise the negations below can never match.
/build/*
!/build/linux/
!/build/windows/
!/build/appicon.png
*.test
*.out

