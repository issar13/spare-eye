# Credentials. Never commit, and never bundle into an installer.
# Each user supplies their own bot token through the UI.
.env
config.json

# Generated media
snapshots/
videos/
DISABLED

# Go build output
/spareeye
/spareeye.exe
/dist/

# Build output only. Packaging metadata under build/ must stay tracked.
# git will not descend into an excluded directory, so the parent is /build/*
# rather than /build/, otherwise the negations below can never match.
/build/*
!/build/linux/
!/build/windows/
!/build/appicon.png
*.test
*.out

# Webview frontend build artifacts
apps/desktop/frontend/node_modules/
apps/desktop/frontend/package.json.md5

# apps/desktop/frontend/dist is build output and is never committed. The Go binary embeds
# it via //go:embed, so it must exist before `go vet`, `go test`, or any build
# that compiles the desktop package: run `make frontend` on a fresh clone.
apps/desktop/frontend/dist/

build/bin/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Internal working notes: planning, status, and release gates stay local.
ROADMAP.md

# Netlify CLI scratch state for the landing page: which site this checkout is
# linked to, and a deploy cache. Machine-local, and it holds the site ID, so it
# is not something to share. The config that matters is netlify.toml.
.netlify/
