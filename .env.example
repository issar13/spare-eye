# Credentials for the headless CLI (cmd/motiond).
#
# Copy this file to .env and fill in your own values, then load it before
# running the detector:
#
#   set -a; source .env; set +a
#   go run ./cmd/motiond
#
# The desktop app stores credentials in config.json instead. These variables are
# only consulted when config.json has no token or chat ID — saved settings win.
#
# Each installation uses its OWN bot. See docs/SETUP-TELEGRAM.md for how to
# create one and find your chat ID.
#
# Save this file with Unix line endings. A .env written on Windows leaves a
# carriage return on every value, which is invisible in an editor.
#
# Never commit the filled-in .env — it is a credential, and .gitignore already
# excludes it.

TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
